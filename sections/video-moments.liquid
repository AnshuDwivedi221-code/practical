{{ 'section-video-moments.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-video-moments.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign heading_content = section.settings.heading
  if section.settings.highlight_text != blank
    assign highlight_span = '<span class="video-moments__heading-highlight">' | append: section.settings.highlight_text | append: '</span>'
    assign heading_content = heading_content | replace: section.settings.highlight_text, highlight_span
  endif
-%}

<div class="video-moments-section color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width video-moments__container">
    <!-- Section Header -->
    <div class="video-moments__header">
      <div class="video-moments__header-left">
        {%- if section.settings.eyebrow != blank -%}
          <div class="video-moments__eyebrow">
            <span class="video-moments__eyebrow-icon">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </span>
            <span>{{ section.settings.eyebrow | escape }}</span>
          </div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="video-moments__heading">
            {{ heading_content }}
          </h2>
        {%- endif -%}

        {%- if section.settings.show_divider -%}
          <div class="video-moments__divider" aria-hidden="true">
            <span class="video-moments__divider-line"></span>
            <span class="video-moments__divider-symbol">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#FF6767"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2"></path>
                <path d="M12 20v2"></path>
                <path d="m4.93 4.93 1.41 1.41"></path>
                <path d="m17.66 17.66 1.41 1.41"></path>
                <path d="M2 12h2"></path>
                <path d="M20 12h2"></path>
                <path d="m6.34 17.66-1.41 1.41"></path>
                <path d="m19.07 4.93-1.41 1.41"></path>
              </svg>
            </span>
            <span class="video-moments__divider-line"></span>
          </div>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <p class="video-moments__description">
            {{ section.settings.description | escape }}
          </p>
        {%- endif -%}
      </div>

      {%- if section.settings.button_label != blank -%}
        <div class="video-moments__header-right">
          <a href="{{ section.settings.button_link | default: '#' }}" class="video-moments__header-btn">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <polygon points="10 8 16 12 10 16 10 8" fill="currentColor"></polygon>
            </svg>
            <span>{{ section.settings.button_label | escape }}</span>
            <svg
              class="video-moments__btn-arrow"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      {%- endif -%}
    </div>

    <!-- Cards Slider & Grid -->
    <video-moments-slider class="video-moments__slider-component">
      <div class="video-moments__grid-wrap">
        <div class="video-moments__grid">
          {%- for block in section.blocks -%}
            <video-moments-card class="video-moments__card" {{ block.shopify_attributes }}>
              <div class="video-moments__media">
                {%- if block.settings.cover_image != blank -%}
                  {{
                    block.settings.cover_image
                    | image_url: width: 800
                    | image_tag: class: 'video-moments__poster', loading: 'lazy', alt: block.settings.title
                    | default: 'Video thumbnail'
                  }}
                {%- elsif block.settings.video != blank and block.settings.video.preview_image != blank -%}
                  {{
                    block.settings.video.preview_image
                    | image_url: width: 800
                    | image_tag: class: 'video-moments__poster', loading: 'lazy', alt: block.settings.title
                    | default: 'Video thumbnail'
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'video-moments__poster placeholder-svg' }}
                {%- endif -%}

                <!-- Video Element: Shopify Hosted Video OR YouTube/Vimeo -->
                {%- if block.settings.video != blank -%}
                  {{
                    block.settings.video
                    | video_tag:
                      autoplay: false,
                      loop: true,
                      muted: true,
                      controls: false,
                      playsinline: true,
                      preload: 'metadata',
                      class: 'video-moments__video'
                  }}
                {%- elsif block.settings.video_url != blank -%}
                  {%- if block.settings.video_url.type == 'youtube' -%}
                    <iframe
                      class="video-moments__iframe"
                      src="https://www.youtube.com/embed/{{ block.settings.video_url.id }}?enablejsapi=1&autoplay=0&mute=1&controls=0&loop=1&playlist={{ block.settings.video_url.id }}&playsinline=1&rel=0&showinfo=0&modestbranding=1"
                      frameborder="0"
                      allow="autoplay; encrypted-media"
                      allowfullscreen
                      loading="lazy"
                      title="{{ block.settings.title | escape }}"
                    ></iframe>
                  {%- elsif block.settings.video_url.type == 'vimeo' -%}
                    <iframe
                      class="video-moments__iframe"
                      src="https://player.vimeo.com/video/{{ block.settings.video_url.id }}?api=1&autoplay=0&muted=1&controls=0&loop=1&background=1"
                      frameborder="0"
                      allow="autoplay; fullscreen"
                      allowfullscreen
                      loading="lazy"
                      title="{{ block.settings.title | escape }}"
                    ></iframe>
                  {%- endif -%}
                {%- endif -%}
              </div>

              <div class="video-moments__play-btn" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <polygon points="8 5 19 12 8 19 8 5"></polygon>
                </svg>
              </div>

              <div class="video-moments__overlay">
                {%- if block.settings.category_tag != blank -%}
                  <span class="video-moments__tag video-moments__tag--{{ block.settings.tag_color | default: 'green' }}">
                    {{ block.settings.category_tag | escape }}
                  </span>
                {%- endif -%}

                {%- if block.settings.title != blank -%}
                  <h3 class="video-moments__card-title">
                    {{ block.settings.title | escape }}
                  </h3>
                {%- endif -%}

                {%- if block.settings.description != blank -%}
                  <p class="video-moments__card-desc">
                    {{ block.settings.description | escape }}
                  </p>
                {%- endif -%}

                {%- if block.settings.duration != blank -%}
                  <span class="video-moments__duration">
                    {{ block.settings.duration | escape }}
                  </span>
                {%- endif -%}
              </div>
            </video-moments-card>
          {%- endfor -%}
        </div>
      </div>

      <div class="video-moments__pagination" aria-label="Slider Pagination"></div>
    </video-moments-slider>
  </div>
</div>

{% schema %}
{
  "name": "Video Moments",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "default": "VIDEO",
      "label": "Eyebrow text"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Live The Most Beautiful Moments",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "highlight_text",
      "default": "Beautiful",
      "label": "Text to highlight in heading"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "default": true,
      "label": "Show decorative divider"
    },
    {
      "type": "textarea",
      "id": "description",
      "default": "A journey through nature, culture and adventure.",
      "label": "Description / Subtitle"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Watch All Videos",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "video_card",
      "name": "Video Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "cover_image",
          "label": "Cover Image / Poster"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Shopify-hosted Video (MP4 upload)"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "accept": ["youtube", "vimeo"],
          "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc",
          "label": "YouTube / Vimeo URL"
        },
        {
          "type": "text",
          "id": "category_tag",
          "default": "TRAVEL",
          "label": "Category Tag"
        },
        {
          "type": "select",
          "id": "tag_color",
          "label": "Badge Color",
          "options": [
            {
              "value": "green",
              "label": "Forest Green"
            },
            {
              "value": "amber",
              "label": "Golden Amber"
            }
          ],
          "default": "green"
        },
        {
          "type": "text",
          "id": "title",
          "default": "Albanian Riviera",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "default": "Crystal clear waters and breathtaking coastlines",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "duration",
          "default": "02:45",
          "label": "Duration (e.g. 02:45)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video Moments",
      "blocks": [
        {
          "type": "video_card",
          "settings": {
            "category_tag": "TRAVEL",
            "tag_color": "green",
            "title": "Albanian Riviera",
            "description": "Crystal clear waters and breathtaking coastlines",
            "duration": "02:45",
            "video_url": "https://www.youtube.com/watch?v=_9VUPq3SxOc"
          }
        },
        {
          "type": "video_card",
          "settings": {
            "category_tag": "DESTINATIONS",
            "tag_color": "amber",
            "title": "Berat – City of a Thousand Windows",
            "description": "Discover the charm of Albania's UNESCO World Heritage site.",
            "duration": "03:12",
            "video_url": "https://www.youtube.com/watch?v=_9VUPq3SxOc"
          }
        },
        {
          "type": "video_card",
          "settings": {
            "category_tag": "CULTURE",
            "tag_color": "green",
            "title": "Traditions That Live On",
            "description": "Experience the rich heritage and traditions of the Albanian people.",
            "duration": "02:30",
            "video_url": "https://www.youtube.com/watch?v=_9VUPq3SxOc"
          }
        },
        {
          "type": "video_card",
          "settings": {
            "category_tag": "FESTIVALS",
            "tag_color": "amber",
            "title": "Festival Vibes in Albania",
            "description": "Feel the energy of music, art and celebration.",
            "duration": "02:58",
            "video_url": "https://www.youtube.com/watch?v=_9VUPq3SxOc"
          }
        }
      ]
    }
  ]
}
{% endschema %}
