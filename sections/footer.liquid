{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'component-list-menu.css' | asset_url | stylesheet_tag }}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .footer {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .footer {
      margin-top: {{ section.settings.margin_top }}px;
    }

    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<footer class="footer footer-custom section-{{ section.id }}-padding" role="contentinfo">
  <div class="page-width">
    {%- if section.settings.show_brand_header -%}
      <div class="footer-custom__top">
        <div class="footer-custom__top-logo">
          {%- if section.settings.brand_logo != blank -%}
            {%- assign brand_logo_alt = section.settings.brand_logo.alt | default: shop.name | escape -%}
            <a href="{{ routes.root_url }}">
              {{
                section.settings.brand_logo
                | image_url: width: 300
                | image_tag:
                  loading: 'lazy',
                  widths: '100, 150, 200, 300',
                  alt: brand_logo_alt
              }}
            </a>
          {%- elsif settings.logo != blank -%}
            <a href="{{ routes.root_url }}">
              {{ settings.logo | image_url: width: 200 | image_tag: loading: 'lazy', alt: shop.name }}
            </a>
          {%- else -%}
            <a href="{{ routes.root_url }}" class="footer-custom__brand-name-text">
              {{ shop.name }}
            </a>
          {%- endif -%}
        </div>

        <div class="footer-custom__top-right">
          {%- if section.settings.brand_bio != blank -%}
            <div class="footer-custom__bio">
              {{ section.settings.brand_bio | newline_to_br }}
            </div>
          {%- endif -%}

          {%- if section.settings.show_social -%}
            <div class="footer-custom__social">
              {%- assign fb_link = settings.social_facebook_link | default: '#' -%}
              <a href="{{ fb_link }}" class="footer-custom__social-btn" aria-label="Facebook" target="_blank" rel="noopener">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              </a>
              {%- assign insta_link = settings.social_instagram_link | default: '#' -%}
              <a href="{{ insta_link }}" class="footer-custom__social-btn" aria-label="Instagram" target="_blank" rel="noopener">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
              </a>
              {%- assign twitter_link = settings.social_twitter_link | default: '#' -%}
              <a href="{{ twitter_link }}" class="footer-custom__social-btn" aria-label="Twitter" target="_blank" rel="noopener">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </a>
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="footer-custom__middle">
      <div class="footer-custom__grid">
        {%- for block in section.blocks -%}
          <div class="footer-custom__col{% if block.type == 'newsletter' %} footer-custom__col--newsletter{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3 class="footer-custom__col-title">{{ block.settings.heading }}</h3>
            {%- endif -%}

            {%- case block.type -%}
              {%- when 'link_list' -%}
                {%- if block.settings.menu != blank -%}
                  <ul class="footer-custom__menu list-unstyled">
                    {%- for link in block.settings.menu.links -%}
                      <li class="footer-custom__menu-item">
                        <svg class="footer-custom__check-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                          <circle cx="10" cy="10" r="8.5" stroke="currentColor" stroke-width="1.8"/>
                          <path d="M6 10.2L8.7 13L14 7.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <a href="{{ link.url }}">{{ link.title | escape }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

              {%- when 'contact' -%}
                <ul class="footer-custom__contact list-unstyled">
                  {%- if block.settings.phone != blank -%}
                    <li class="footer-custom__contact-item">
                      <span class="footer-custom__contact-badge" aria-hidden="true">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                        </svg>
                      </span>
                      <a href="tel:{{ block.settings.phone | replace: ' ', '' }}">{{ block.settings.phone }}</a>
                    </li>
                  {%- endif -%}
                  {%- if block.settings.email != blank -%}
                    <li class="footer-custom__contact-item">
                      <span class="footer-custom__contact-badge" aria-hidden="true">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                          <polyline points="22,6 12,13 2,6"></polyline>
                        </svg>
                      </span>
                      <a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a>
                    </li>
                  {%- endif -%}
                  {%- if block.settings.address != blank -%}
                    <li class="footer-custom__contact-item">
                      <span class="footer-custom__contact-badge" aria-hidden="true">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                          <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                      </span>
                      <div class="footer-custom__address">
                        {{ block.settings.address }}
                      </div>
                    </li>
                  {%- endif -%}
                </ul>

              {%- when 'newsletter' -%}
                <div class="footer-custom__newsletter-wrapper">
                  {%- form 'customer', id: 'ContactFooterBlock', class: 'footer-custom__form' -%}
                    <input type="hidden" name="contact[tags]" value="newsletter">
                    <div class="footer-custom__form-group">
                      <input
                        id="NewsletterForm--{{ block.id }}"
                        type="email"
                        name="contact[email]"
                        class="footer-custom__input"
                        value="{{ form.email }}"
                        aria-required="true"
                        autocorrect="off"
                        autocapitalize="off"
                        autocomplete="email"
                        {% if form.errors %}
                          autofocus
                          aria-invalid="true"
                          aria-describedby="ContactFooterBlock-error"
                        {% elsif form.posted_successfully? %}
                          aria-describedby="ContactFooterBlock-success"
                        {% endif %}
                        placeholder="{{ block.settings.placeholder | default: 'Enter Email Address' }}"
                        required
                      >
                      <button type="submit" class="footer-custom__submit-btn" name="commit">
                        {{ block.settings.button_label | default: 'Subscribe Now' }}
                      </button>
                    </div>
                    {%- if form.errors -%}
                      <small class="footer-custom__msg footer-custom__msg--error" id="ContactFooterBlock-error">
                        {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
                      </small>
                    {%- endif -%}
                    {%- if form.posted_successfully? -%}
                      <div class="footer-custom__msg footer-custom__msg--success" id="ContactFooterBlock-success" tabindex="-1">
                        {{ 'newsletter.success' | t }}
                      </div>
                    {%- endif -%}
                  {%- endform -%}
                </div>

              {%- when 'text' -%}
                <div class="footer-custom__bio">
                  {{ block.settings.subtext }}
                </div>

              {%- when 'image' -%}
                {%- if block.settings.image != blank -%}
                  <div class="footer-block-image {{ block.settings.alignment }}">
                    <img
                      src="{{ block.settings.image | image_url: width: 400 }}"
                      alt="{{ block.settings.image.alt | escape }}"
                      loading="lazy"
                      width="{{ block.settings.image.width }}"
                      height="{{ block.settings.image.height }}"
                    >
                  </div>
                {%- endif -%}

              {%- when '@app' -%}
                {% render block %}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- liquid
      assign show_country = false
      if section.settings.enable_country_selector and localization.available_countries.size > 1
        assign show_country = true
      endif

      assign show_language = false
      if section.settings.enable_language_selector and localization.available_languages.size > 1
        assign show_language = true
      endif

      assign show_payment = false
      if section.settings.payment_enable and shop.enabled_payment_types.size > 0
        assign show_payment = true
      endif
    -%}

    {%- if show_country or show_language or show_payment -%}
      <div class="footer-custom__extras">
        <div class="footer__column footer__localization isolate">
          {%- if show_country -%}
            <localization-form>
              {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
                <div>
                  <h2 class="caption-large text-body" id="FooterCountryLabel">{{ 'localization.country_label' | t }}</h2>
                  {%- render 'country-localization', localPosition: 'FooterCountry' -%}
                </div>
              {%- endform -%}
            </localization-form>
          {%- endif -%}

          {%- if show_language -%}
            <localization-form>
              {%- form 'localization', id: 'FooterLanguageForm', class: 'localization-form' -%}
                <div>
                  <h2 class="caption-large text-body" id="FooterLanguageLabel">
                    {{ 'localization.language_label' | t }}
                  </h2>
                  {%- render 'language-localization', localPosition: 'FooterLanguage' -%}
                </div>
              {%- endform -%}
            </localization-form>
          {%- endif -%}
        </div>

        {%- if show_payment -%}
          <div class="footer__column footer__column--info">
            <div class="footer__payment">
              <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
              <ul class="list list-payment" role="list">
                {%- for type in shop.enabled_payment_types -%}
                  <li class="list-payment__item">
                    {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="footer-custom__bottom">
      <div class="footer-custom__copyright">
        {{ section.settings.copyright_text | default: 'Copyright &copy; 2025 KRIS BEE BACON All rights reserved.' }}
      </div>
      <ul class="footer-custom__policy-list list-unstyled">
        {%- if section.settings.show_policy and shop.policies.size > 0 -%}
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}
              <li>
                <a href="{{ policy.url }}" class="footer-custom__policy-link">{{ policy.title | escape }}</a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <li><a href="/policies/terms-of-service" class="footer-custom__policy-link">Terms of Service</a></li>
          <li><a href="/policies/privacy-policy" class="footer-custom__policy-link">Privacy Policy</a></li>
          <li><a href="/policies/refund-policy" class="footer-custom__policy-link">Refund Policy</a></li>
          <li><a href="/policies/subscription-policy" class="footer-custom__policy-link">Subscription Policy</a></li>
        {%- endif -%}
      </ul>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "link_list",
      "name": "t:sections.footer.blocks.link_list.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Quick Links",
          "label": "t:sections.footer.blocks.link_list.settings.heading.label"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "t:sections.footer.blocks.link_list.settings.menu.label"
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contact Info",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Contact",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "phone",
          "default": "+61 (0)2 9904 9225",
          "label": "Phone Number"
        },
        {
          "type": "text",
          "id": "email",
          "default": "honey@krisbeebacon.com",
          "label": "Email Address"
        },
        {
          "type": "textarea",
          "id": "address",
          "default": "Kris Bee Bacon<br>Handmade in Sydney,<br>Australia",
          "label": "Address"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Subscribe Our Newsletter",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "placeholder",
          "default": "Enter Email Address",
          "label": "Placeholder text"
        },
        {
          "type": "text",
          "id": "button_label",
          "default": "Subscribe Now",
          "label": "Button label"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "t:sections.footer.blocks.text.settings.heading.default",
          "label": "t:sections.footer.blocks.text.settings.heading.label"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "default": "t:sections.footer.blocks.text.settings.subtext.default",
          "label": "t:sections.footer.blocks.text.settings.subtext.label"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "range",
          "id": "image_width",
          "min": 50,
          "max": 550,
          "step": 5,
          "unit": "px",
          "label": "Width",
          "default": 100
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Alignment",
          "options": [
            {
              "value": "",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "center"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Brand Header"
    },
    {
      "type": "checkbox",
      "id": "show_brand_header",
      "default": true,
      "label": "Show top brand header"
    },
    {
      "type": "image_picker",
      "id": "brand_logo",
      "label": "Brand Logo (optional image)"
    },
    {
      "type": "textarea",
      "id": "brand_bio",
      "default": "In the mystical realm of the Baconverse, every masterpiece is crafted with care.\nA proud division of Centauron Pty Ltd T/A Kris Bee Bacon",
      "label": "Brand Bio / Description"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": true,
      "label": "t:sections.footer.settings.show_social.label"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "default": true,
      "label": "t:sections.footer.settings.newsletter_enable.label"
    },
    {
      "type": "inline_richtext",
      "id": "newsletter_heading",
      "default": "Subscribe Our Newsletter",
      "label": "t:sections.footer.settings.newsletter_heading.label"
    },
    {
      "type": "header",
      "content": "Copyright & Policies"
    },
    {
      "type": "inline_richtext",
      "id": "copyright_text",
      "default": "Copyright &copy; 2025 KRIS BEE BACON All rights reserved.",
      "label": "Copyright Text"
    },
    {
      "type": "checkbox",
      "id": "show_policy",
      "default": true,
      "label": "t:sections.footer.settings.show_policy.label"
    },
    {
      "type": "header",
      "content": "Localization & Payments"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": false,
      "label": "t:sections.footer.settings.enable_country_selector.label"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": false,
      "label": "t:sections.footer.settings.enable_language_selector.label"
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "default": false,
      "label": "t:sections.footer.settings.payment_enable.label"
    },
    {
      "type": "checkbox",
      "id": "enable_follow_on_shop",
      "default": false,
      "label": "t:sections.footer.settings.enable_follow_on_shop.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.footer.settings.margin_top.label",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "link_list",
        "settings": {
          "heading": "Quick Links"
        }
      },
      {
        "type": "link_list",
        "settings": {
          "heading": "Support"
        }
      },
      {
        "type": "contact",
        "settings": {
          "heading": "Contact"
        }
      },
      {
        "type": "newsletter",
        "settings": {
          "heading": "Subscribe Our Newsletter"
        }
      }
    ]
  }
}
{% endschema %}
